pkgbase = lyrics-term
	pkgdesc = Terminal synced lyrics for any MPRIS-compatible music player
	pkgver = 2.0.0
	pkgrel = 1
	url = https://github.com/vitalikr2x3/lyrics-term
	arch = x86_64
	license = MIT
	makedepends = meson
	makedepends = ninja
	makedepends = pkgconf
	depends = dbus
	depends = curl
	depends = freetype2
	depends = nlohmann-json
	optdepends = kitty: graphical renderer (--renderer kitty)
	optdepends = noto-fonts: default font for the kitty renderer
	optdepends = ttf-dejavu: fallback font for the kitty renderer
	optdepends = mpv-mpris: MPRIS support for mpv
	options = !debug
	source = lyrics-term-2.0.0.tar.gz::https://github.com/vitalikr2x3/lyrics-term/archive/refs/tags/v2.0.0.tar.gz
